{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2022-11-01-preview",
      "name": "sentinel-law/Microsoft.SecurityInsights/fa3213a4-84d5-45b2-a256-4c4897f1912a",
      "kind": "Scheduled",
      "properties": {
        "displayName": "Test Scheduled Detection Rule",
        "description": "Deployment test via GitHub Sentinel Repositories",
        "severity": "Medium",
        "enabled": true,
        "query": "SecurityEvent | take 10",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT5H",
        "suppressionEnabled": false
      }
    }
  ]
}
